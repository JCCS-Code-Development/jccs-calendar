# Clean-URL routing for the flat-file API (production/Apache). See router.php
# for the equivalent used by the local PHP dev server, which ignores
# .htaccess entirely — keep the two route tables in sync.
RewriteEngine On
RewriteBase /api/

# Stop mod_dir from 301-redirecting /api/jobs -> /api/jobs/ before the rules
# below can route it — every route name here collides with a subfolder.
DirectorySlash Off

# Real files (uploaded photos, etc.) serve as-is. NOTE: no !-d guard —
# route names deliberately match subfolder names (jobs/, events/, …), so a
# directory check here would skip every one of them.
RewriteCond %{REQUEST_FILENAME} !-f

RewriteRule ^events/([0-9]+)/mark-done$ events/mark_done.php?id=$1 [QSA,L]
RewriteRule ^events/([0-9]+)/export\.ics$ events/export_ics.php?id=$1 [QSA,L]
RewriteRule ^events/([0-9]+)$ events/item.php?id=$1 [QSA,L]
RewriteRule ^events$ events/index.php [QSA,L]
RewriteRule ^my-events$ events/my.php [QSA,L]
RewriteRule ^todos$ events/todos.php [QSA,L]
RewriteRule ^calendar-events$ events/calendar.php [QSA,L]
RewriteRule ^event-types$ event-types/index.php [QSA,L]
RewriteRule ^external-calendar$ calendar/external.php [QSA,L]
RewriteRule ^linked-outlook$ calendar/linked_outlook.php [QSA,L]
RewriteRule ^calendar\.ics$ calendar/feed.php [QSA,L]

RewriteRule ^users/([0-9]+)$ users/item.php?id=$1 [QSA,L]
RewriteRule ^users$ users/index.php [QSA,L]
RewriteRule ^roles$ roles/index.php [QSA,L]

RewriteRule ^clients/([0-9]+)$ clients/item.php?id=$1 [QSA,L]
RewriteRule ^clients$ clients/index.php [QSA,L]

RewriteRule ^jobs/sync-fieldclock$ jobs/sync_fieldclock.php [QSA,L]
RewriteRule ^jobs/photo$ jobs/photo.php [QSA,L]
RewriteRule ^jobs/([0-9]+)$ jobs/item.php?id=$1 [QSA,L]
RewriteRule ^jobs$ jobs/index.php [QSA,L]

RewriteRule ^push/key$ push/key.php [QSA,L]
RewriteRule ^push/subscribe$ push/subscribe.php [QSA,L]
RewriteRule ^push/unsubscribe$ push/unsubscribe.php [QSA,L]

RewriteRule ^auth/verify$ auth/verify.php [QSA,L]
RewriteRule ^auth/login$ auth/login.php [QSA,L]
RewriteRule ^auth/refresh$ auth/refresh.php [QSA,L]
RewriteRule ^auth/logout$ auth/logout.php [QSA,L]
